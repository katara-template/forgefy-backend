# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=changeme-replace-with-32-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
# JSON array of allowed CORS origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# ── Firebase / Firestore ──────────────────────────────────────────────────────
# Preferred (production/Docker): base64-encoded service-account JSON.
#   base64 -w0 path/to/service-account.json
FIREBASE_CREDENTIALS_JSON=
# Alternative (local dev): path to the service-account JSON file on disk.
# Used only if FIREBASE_CREDENTIALS_JSON is unset.
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Deepgram ──────────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Ollama (local Qwen3) ──────────────────────────────────────────────────────
# Use http://ollama:11434 inside Docker; http://localhost:11434 for local dev
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=300

# ── Blueprint model: "claude" | "gemini" | "Qwen3" ────────────────────────────
BP_MODEL=claude
# ── Build model (code generation): "claude" | "gemini" | "Qwen3" | "gpt" ─────
BUILD_MODEL=gemini

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Recall.ai ─────────────────────────────────────────────────────────────────
RECALL_API_KEY=
RECALL_REGION=us-east-1
RECALL_WORKSPACE_VERIFICATION_SECRET=
# Set to your publicly reachable API URL so Recall can POST webhooks to it.
# For local dev use ngrok: ngrok http 8000  →  https://xxxx.ngrok.io
PUBLIC_API_BASE_URL=

# ── Cloudinary (APK / bundle storage) ────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Cloudflare Pages (web preview deployments) ────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Appetize.io (Flutter APK browser preview) ─────────────────────────────────
APPETIZE_API_TOKEN=

# ── GitHub OAuth App (personal GitHub linking) ────────────────────────────────
# Create at: github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000

# ── GitHub (used for build-template access; not the OAuth app above) ─────────
GITHUB_TOKEN=

# ── FAL.AI (image + video generation) ─────────────────────────────────────────
FAL_API_KEY=

# ── Notchpay (payments — card, MTN MoMo, Orange Money) ────────────────────────
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_SECRET_HASH=

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=
