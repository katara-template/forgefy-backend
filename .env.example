# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=changeme-replace-with-32-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
# JSON array of allowed CORS origins. This is the real allowlist — browsers are
# refused any origin not listed here.
# :3000/:8080 = forgefy-meeting-to-app dev server, :8081 = forgefy-dashboard dev server
#
# In production add every deployed frontend origin, e.g.
#   CORS_ORIGINS=["https://app.forgefy.dev", "https://admin.forgefy.dev"]
# A literal "*" is accepted but disables credentialed requests — don't rely on it.
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://localhost:8081"]

# ── Firebase / Firestore ──────────────────────────────────────────────────────
# Preferred (production/Docker): base64-encoded service-account JSON.
#   base64 -w0 path/to/service-account.json
FIREBASE_CREDENTIALS_JSON=
# Alternative (local dev): path to the service-account JSON file on disk.
# Used only if FIREBASE_CREDENTIALS_JSON is unset.
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Deepgram ──────────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Ollama (local Qwen3) ──────────────────────────────────────────────────────
# Use http://ollama:11434 inside Docker; http://localhost:11434 for local dev
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=300

# ── OpenRouter (hosted backend for the "Qwen3" setting) ───────────────────────
# Set this key and BP_MODEL/BUILD_MODEL="Qwen3" stops calling local Ollama and
# routes each action to the model best suited to it (see app/ai/openrouter.py):
# transcript synthesis → long-context JSON model, code → Qwen3-Coder,
# naming/classification → a small fast model. Leave blank to keep using Ollama.
OPENROUTER_API_KEY=
# Pin one model for every action, bypassing routing (debugging aid).
OPENROUTER_MODEL=
# Fall back to cheap paid models (DeepSeek/Gemini) when the free tier is rate-limited.
OPENROUTER_ALLOW_PAID=false
OPENROUTER_TIMEOUT=180
OPENROUTER_SITE_URL=https://forgefy.app
OPENROUTER_APP_NAME=Forgefy

# ── Blueprint model: "claude" | "gemini" | "Qwen3" ────────────────────────────
BP_MODEL=claude
# ── Build model (code generation): "claude" | "gemini" | "Qwen3" | "gpt" ─────
BUILD_MODEL=gemini

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Recall.ai ─────────────────────────────────────────────────────────────────
RECALL_API_KEY=
RECALL_REGION=us-east-1
RECALL_WORKSPACE_VERIFICATION_SECRET=
# Set to your publicly reachable API URL so Recall can POST webhooks to it.
# For local dev use ngrok: ngrok http 8000  →  https://xxxx.ngrok.io
PUBLIC_API_BASE_URL=
# JPEG the bot displays as its camera feed in meetings (its "avatar").
# Drop your image at assets/bot_avatar.jpg (16:9, e.g. 1280x720, ≤ 2 MB)
# or point this at another path. If the file is missing, the bot joins
# with the default letter avatar.
RECALL_BOT_AVATAR_PATH=assets/bot_avatar.jpg

# ── Zoom bot provider ────────────────────────────────────────────────────────
# Which bot joins ZOOM meetings. Meet and Teams always use Recall.
#
#   recall       Recall.ai cloud bot (default). Nothing else below is needed.
#   self_hosted  Our own Meeting SDK container. Requires everything below,
#                the image built (docker compose --profile build-only build
#                zoom-bot), and the Docker socket mounted into the worker.
#                See zoom-bot/README.md.
ZOOM_BOT_PROVIDER=recall

# Meeting SDK app credentials from marketplace.zoom.us. The secret only signs
# the bot's JWT here — it is never passed into the bot container.
ZOOM_SDK_CLIENT_ID=
ZOOM_SDK_CLIENT_SECRET=

# OAuth credentials, used to mint the per-meeting OBF token Zoom has REQUIRED
# since 2026-03-02 for joining meetings hosted on OTHER Zoom accounts. Without
# a linked host account the bot can only join meetings on your own account.
# Leave blank if one Marketplace app provides both features (the usual case) —
# the ZOOM_SDK_* values above are used instead.
#
# Register this exact redirect URL on the Marketplace app:
#   <PUBLIC_API_BASE_URL>/api/v1/zoom/callback
# Scopes: user:read:token, user:read, meeting:read:local_recording_token
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=

# Image the per-meeting bot container is launched from.
ZOOM_BOT_IMAGE=forgefy-zoom-bot:latest
# Docker network the bot joins so it can reach the API by name. Must match the
# compose project's network — usually <project-dir>_default.
ZOOM_BOT_NETWORK=forgefy-backend_default
# Where the bot posts events. Internal, so no ngrok/public URL needed for Zoom.
ZOOM_BOT_CALLBACK_URL=http://api:5000

# Shown in the participant list — the bot's primary disclosure to the meeting.
ZOOM_BOT_DISPLAY_NAME=Forgefy Notetaker
# Ask the host for recording permission before capturing any audio. Zoom
# enforces this regardless; false only stops the bot asking, which then needs a
# pre-authorized local recording join token.
ZOOM_BOT_REQUIRE_HOST_CONSENT=true
# Leave once no one else remains, so an abandoned meeting can't hold a
# container open. 0 disables.
ZOOM_BOT_LEAVE_AFTER_SILENCE_SECS=120

# ── Cloudinary (APK / bundle storage) ────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Cloudflare Pages (web preview deployments) ────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Appetize.io (Flutter APK browser preview) ─────────────────────────────────
APPETIZE_API_TOKEN=

# ── GitHub OAuth App (personal GitHub linking) ────────────────────────────────
# Create at: github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000

# ── GitHub (used for build-template access; not the OAuth app above) ─────────
GITHUB_TOKEN=

# ── Supabase OAuth App (connect a user's Supabase account to provision DBs) ──
# Create at: your Supabase organization → Settings → OAuth Apps
# Redirect URI: {PUBLIC_API_BASE_URL}/api/v1/auth/supabase/callback
SUPABASE_CLIENT_ID=
SUPABASE_CLIENT_SECRET=

# ── Neon (embedded model — one platform API key, no per-user OAuth) ─────────
# Create at: console.neon.tech → Project Settings → API Keys
NEON_API_KEY=

# ── Firebase OAuth App (connect a user's Google account to provision a new
# Firebase/Firestore project under THEIR GCP account — separate from the
# Firebase / Firestore section above, which is Forgefy's own infrastructure) ──
# Create at: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# Enable these APIs on the OAuth client's GCP project: Cloud Resource Manager API,
# Firebase Management API, Firestore API.
# Redirect URI: {PUBLIC_API_BASE_URL}/api/v1/auth/firebase/callback
FIREBASE_OAUTH_CLIENT_ID=
FIREBASE_OAUTH_CLIENT_SECRET=

# ── Secrets encryption (OAuth tokens, DB passwords stored at rest) ───────────
# Any string works — it's hashed into a Fernet key. Change in production.
SECRETS_ENCRYPTION_KEY=changeme-replace-with-a-real-secret

# ── FAL.AI (image + video generation) ─────────────────────────────────────────
FAL_API_KEY=

# ── Notchpay (payments — card, MTN MoMo, Orange Money) ────────────────────────
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_SECRET_HASH=

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Forgefy UI SDK ────────────────────────────────────────────────────────────
# true → build/update agents use the forgefy_ui (Flutter) and @forgefy/ui
# (React web + native) layout/animation packages and force them into generated
# manifests. Keep false until those packages are published to pub.dev / npm,
# otherwise every generated build fails at pub-get / npm-install.
FORGEFY_UI_ENABLED=false