# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=changeme-replace-with-32-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# JSON array of allowed CORS origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://voxa:voxa@localhost:5432/voxa

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Deepgram ──────────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Ollama (local Qwen3) ──────────────────────────────────────────────────────
# Use http://ollama:11434 inside Docker; http://localhost:11434 for local dev
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=300

# ── Blueprint model: "claude" | "gemini" | "Qwen3" ────────────────────────────
BP_MODEL=claude

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# ── Recall.ai ─────────────────────────────────────────────────────────────────
RECALL_API_KEY=
RECALL_REGION=us-east-1
RECALL_WORKSPACE_VERIFICATION_SECRET=
# Set to your publicly reachable API URL so Recall can POST webhooks to it.
# For local dev use ngrok: ngrok http 5000  →  https://xxxx.ngrok.io
PUBLIC_API_BASE_URL=
