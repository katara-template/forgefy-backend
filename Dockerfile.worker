# syntax=docker/dockerfile:1
# Forgefy Celery build worker - multi-stage, SDKs kept (runtime), caches pruned.
#
# This worker compiles user projects (Flutter / React Native / Next.js) so
# Flutter, the Android SDK, OpenJDK 21 and Node 22 are RUNTIME requirements
# here (unlike the lean API image). To keep disk usage down we:
#   - build Python wheels in a separate stage so gcc/cpp/binutils/perl never
#     ship in the final image,
#   - clean apt lists, pip cache, npm cache and SDK temp files in the SAME RUN
#     layer that creates them,
#   - prune Flutter / Android sdkmanager temp artifacts.

# ---- Stage 1: build Python wheels ----------------------------------------
FROM python:3.14-slim AS wheel-builder

WORKDIR /build

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      gcc \
      cpp \
      binutils \
      perl \
      make \
      xz-utils \
      ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip \
  && pip install --no-cache-dir -r requirements.txt \
  && rm -rf /root/.cache/pip

# ---- Stage 2: worker runtime ----------------------------------------------
FROM python:3.14-slim AS runtime

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# ---- Base system packages (runtime + build-time extraction) --------------
# git/curl/unzip are needed to clone & unpack scaffolded projects. xz-utils is
# needed (build-time) to extract the Flutter .tar.xz. No gcc/cpp/binutils/perl
# are shipped - wheels come from stage 1.
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl \
      git \
      unzip \
      xz-utils \
      ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# ---- Node.js 22 (runtime: Next.js / React Native builds, npm install) -----
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
  && apt-get install -y --no-install-recommends nodejs \
  && rm -rf /var/lib/apt/lists/*

# The worker's CMD runs as --uid=nobody; $HOME=/root/.npm is unwritable to
# nobody, so point npm/npx at a world-writable cache and create it up front.
ENV npm_config_cache=/tmp/.npm
RUN mkdir -p /tmp/.npm && chmod 777 /tmp/.npm

# ---- OpenJDK 21 (runtime: Gradle Android builds) -------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
      openjdk-21-jdk-headless \
  && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64 \
    ANDROID_HOME=/opt/android-sdk

ENV PATH=$PATH:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/build-tools/34.0.0

# ---- Android SDK (runtime: flutter build apk) ----------------------------
RUN mkdir -p $ANDROID_HOME/cmdline-tools \
  && curl -o /tmp/cmdline-tools.zip \
       "https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip" \
  && unzip -q /tmp/cmdline-tools.zip -d /tmp/ct \
  && mv /tmp/ct/cmdline-tools $ANDROID_HOME/cmdline-tools/latest \
  && rm -rf /tmp/cmdline-tools.zip /tmp/ct

# sdkmanager temp/cache are removed in the SAME layer as the download.
RUN yes | sdkmanager --licenses > /dev/null 2>&1 \
  && sdkmanager \
       "platform-tools" \
       "build-tools;34.0.0" \
       "platforms;android-34" \
  && rm -rf /tmp/* \
       $ANDROID_HOME/.temp \
       $ANDROID_HOME/.cache

# ---- Flutter SDK (runtime: flutter build apk) ----------------------------
ARG FLUTTER_VERSION=3.24.4

ENV FLUTTER_HOME=/opt/flutter \
    PUB_CACHE=/opt/pub-cache

ENV PATH=$PATH:$FLUTTER_HOME/bin:$FLUTTER_HOME/bin/cache/dart-sdk/bin

RUN curl -o /tmp/flutter.tar.xz \
      "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
  && tar xf /tmp/flutter.tar.xz -C /opt \
  && rm /tmp/flutter.tar.xz \
  && git config --global --add safe.directory /opt/flutter \
  && flutter config --no-analytics \
  && flutter precache --android \
  && flutter doctor --android-licenses || true

# Prune Flutter / Dart caches that only duplicate on first real run. Keep
# /opt/flutter/bin/cache (the tool + Android engine needed to build).
RUN rm -rf /tmp/flutter* \
    /opt/flutter/bin/cache/dart-sdk/pkg/analyzer \
    /opt/flutter/.dart_tool

# ---- Python (installed wheels from stage 1) -------------------------------
COPY --from=wheel-builder /usr/local/lib/python3.14/site-packages /usr/local/lib/python3.14/site-packages
COPY --from=wheel-builder /usr/local/bin /usr/local/bin

# ---- Playwright ----------------------------------------------------------
# The worker's bot path goes through Recall.ai; the legacy Playwright
# MeetConnector is not wired in. Playwright's Python package stays installed,
# and Chromium is fetched only when INSTALL_PLAYWRIGHT_BROWSERS=true.
ARG INSTALL_PLAYWRIGHT_BROWSERS=false
RUN if [ "$INSTALL_PLAYWRIGHT_BROWSERS" = "true" ]; then \
      playwright install chromium --with-deps ; \
    fi

# ---- Application ----------------------------------------------------------
COPY . .

# ---- Final environment ----------------------------------------------------
ENV HOME=/home/nobody \
    PUB_CACHE=/opt/pub-cache

# Keep the toolchain paths available for build tasks.
ENV PATH=$PATH:$FLUTTER_HOME/bin:$FLUTTER_HOME/bin/cache/dart-sdk/bin:$ANDROID_HOME/platform-tools

# Concurrency is NOT passed here - a --concurrency flag overrides
# celery_app.conf, which is what let this image and docker-compose.yml drift
# apart; it now comes from CELERY_CONCURRENCY (default 2).
CMD ["celery", "-A", "app.workers.celery_app:celery_app", "worker", "--loglevel=info", "-Q", "meeting.audio,meeting.transcribe,meeting.extract,build", "-B", "-s", "/tmp/celerybeat-schedule", "--uid=nobody"]