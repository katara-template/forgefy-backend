# .dockerignore - keep the build context small. Only the Python backend files
# needed by the forgefy-api image are copied in. Heavy and generated directories,
# plus the separately-developed SDK packages, are excluded so the context upload
# is fast and does not waste Cloudflare build disk.
# -----------------------------------------------------------------------------

# Version control / CI
.git
.gitignore
.github

# Python / backend artifacts
venv/
forgefy_backend.egg-info/
__pycache__/
*.py[cod]
*$py.class
*.so
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
celerybeat-schedule*
*.log

# Environments / secrets - never ship these into an image
.env
.env.example
firebase-credentials.json

# Generated / local tooling state
.wrangler/
.dart_tool/
.build/
.cache/
.pub-cache/
.gradle/
.windows/
.android/

# SDK packages developers publish from this repo. Not part of the deployed
# backend service and not needed to build the API image.
sdks/

# The Zoom bot has its own Dockerfile (./zoom-bot/Dockerfile) and image; its
# SDK sources/images are not needed in the backend/image context here.
zoom-bot/

# Local worker / scratch folders
gentle-meadow-b376/

# Docs and tests are only needed locally, not at build or runtime
docs/
tests/